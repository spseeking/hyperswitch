@startuml c4-l3-component-router
' C4 Level 3 - Components inside the Router container
' Grounded in: crates/router/src/{routes,core,services,db,workflows}, crates/hyperswitch_connectors, crates/euclid, crates/storage_impl
!include lib/C4_Component.puml

LAYOUT_WITH_LEGEND()
title C4 L3 — Components: Router (hyperswitch-server)

Container_Ext(sdk_web, "Checkout SDK / links", "JS", "Client-side payment collection")
Container_Ext(merchant_app, "Merchant application", "any", "Server-to-server caller")
System_Ext(connectors_ext, "Connectors", "~150 external providers")
ContainerDb_Ext(pg, "PostgreSQL", "PostgreSQL", "Authoritative domain store")
ContainerDb_Ext(redis, "Redis", "Redis", "Cache, locks, KV streams, queues")
Container_Ext(locker, "Card Vault (locker)", "Rust", "PCI card storage")
Container_Ext(keymanager, "Key Manager", "Rust", "Per-entity DEKs")
Container_Ext(open_router, "Open Router", "gRPC", "Dynamic routing scores")
Container_Ext(kafka, "Kafka", "Kafka", "Event bus")

Container_Boundary(router, "Router") {
  Component(http, "HTTP app & middleware", "actix-web (routes/app.rs, middleware.rs)", "Route table for v1/v2 scopes plus middleware: log-span/request-id init, HTTP 400 request detail logging, Accept-Language, request/response metrics, CORS")
  Component(auth, "Authentication & authorization", "services/authentication.rs, services/authorization", "ApiKeyAuth, PublishableKeyAuth, EphemeralKeyAuth, JWTAuth + RBAC (ParentGroup→Resource→Read/Write), AdminApiAuth, partial-auth HMAC, platform/org scoping")
  Component(api_locking, "API locking", "core/api_locking.rs", "Redis-backed per-resource locks to serialise concurrent operations on the same payment")

  Component(payments_core, "Payments core", "core/payments.rs + core/payments/operations/*", "Operation pipeline (validate → get_tracker → domain → update_tracker → connector → post_update_tracker) for create/confirm/capture/void/sync/session/complete-authorize")
  Component(pm_core, "Payment methods & vault", "core/payment_methods, crates/payment_methods", "Save/list/delete payment methods, temp & permanent locker tokens, network tokenization, external vault proxy, payment-method sessions")
  Component(refunds_core, "Refunds core", "core/refunds.rs", "Full/partial refunds, refund sync, refund retries via scheduler")
  Component(disputes_core, "Disputes core", "core/disputes", "Dispute lifecycle, evidence upload/attach/delete, accept, aggregates")
  Component(mandates_core, "Mandates & recurring", "core/mandate, core/payments/operations/payment_recurrence.rs", "Mandate setup (zero-amount/CIT), MIT charges, network transaction id reuse, revoke")
  Component(payouts_core, "Payouts core", "core/payouts (feature payouts)", "Payout create/confirm/fulfill/cancel, payout links, payout retries, payout routing")
  Component(subs_core, "Subscriptions & invoices", "core/subscription, crates/subscriptions", "Plans/items, estimates, create-confirm, pause/resume/cancel, invoice sync workflow")
  Component(recovery_core, "Revenue recovery", "core/revenue_recovery (features v2+revenue_recovery)", "Passive churn recovery: retry scheduling via recovery decider, billing-connector invoice events")
  Component(routing_core, "Routing & decision engines", "core/routing, core/payments/routing.rs, crates/euclid, crates/kgraph_utils", "Static Euclid DSL rules, constraint-graph eligibility, volume split, success-rate/elimination/contract routing, debit routing, fallback")
  Component(decision_mgr, "Decision manager & surcharge", "core/conditional_config.rs, core/payments (call_decision_manager, populate_surcharge_details)", "3DS/authentication-type rules, surcharge & tax rules, three_ds_decision_rule engine")
  Component(frm_core, "Fraud & risk (FRM)", "core/fraud_check.rs (feature frm)", "Pre/post FRM checks, approve/reject flows, fulfillment signals")
  Component(auth3ds, "Authentication (3DS/CTP)", "core/authentication, core/unified_authentication_service", "External 3DS pre-auth/auth, ARes/CRes, Click to Pay, authentication API resource")
  Component(blocklist, "Blocklist & card testing guard", "core/blocklist, core/card_testing_guard", "Fingerprint/card/BIN/extended blocklists, batch upload jobs, velocity guards per profile")
  Component(webhooks_in, "Incoming webhooks", "core/webhooks/incoming.rs", "Source verification, event mapping, idempotent state reconciliation, relay & recovery webhooks")
  Component(webhooks_out, "Outgoing webhooks", "core/webhooks/outgoing.rs, workflows/outgoing_webhook_retry.rs", "Event persistence (events table), signing, delivery, scheduled retries, manual retry API")
  Component(admin_core, "Accounts & configuration", "core/admin.rs, core/api_keys.rs, core/profile_acquirer.rs", "Org/merchant/profile/connector-account CRUD, API keys, acquirer config, connector onboarding, GSM, themes")
  Component(user_core, "User management", "core/user*, routes/user", "Signup/signin, TOTP/2FA & recovery codes, SSO/OIDC, invites, roles, tenants, sample data, dashboard metadata")
  Component(links_core, "Generic links", "core/generic_link, core/payment_link.rs, core/payout_link.rs", "Hosted payment links, payout links, payment-method collect links with themable UI config")
  Component(relay_core, "Relay & proxy", "core/relay.rs, core/proxy.rs", "Pass-through refund/capture/void/incremental-auth for merchants not routing payments through Hyperswitch; authenticated proxy with vault detokenization")
  Component(offers_core, "Offer engine client", "core/offer_engine", "Offer eligibility/apply against an external offer engine, discount amount handling")
  Component(analytics_comp, "Analytics & reports", "crates/analytics (feature olap)", "Payment/refund/dispute/FRM/auth metrics, filters, sankey, reports, global search")

  Component(connector_layer, "Connector integration layer", "crates/hyperswitch_connectors + hyperswitch_interfaces", "ConnectorIntegration<Flow, Req, Res> impls per connector: request build, sign, execute, response transform, error & status mapping, webhook parsing")
  Component(ucs_client, "UCS / external service clients", "core/unified_connector_service.rs, crates/external_services", "gRPC clients (UCS, dynamic routing, recovery decider), email, file storage, forex, CRM, superposition")
  Component(storage, "Storage layer", "crates/storage_impl, router/src/db", "Repository traits over PostgreSQL + Redis KV (RedisKv/PostgresOnly per merchant), reverse lookups, caching, mock store for tests")
  Component(scheduler_api, "Process tracker API", "crates/scheduler, router/src/workflows", "Inserts/updates process_tracker tasks; workflow implementations executed by the consumer")
  Component(events_comp, "Event & audit publisher", "crates/events, router/src/events", "Kafka/logging sinks for api, connector, outgoing-webhook, routing, audit and analytics events")
}

Rel(sdk_web, http, "HTTPS")
Rel(merchant_app, http, "HTTPS")
Rel(http, auth, "authenticate + authorize")
Rel(http, api_locking, "acquire lock for mutating flows")
Rel(http, payments_core, "dispatch")
Rel(http, refunds_core, "dispatch")
Rel(http, disputes_core, "dispatch")
Rel(http, payouts_core, "dispatch")
Rel(http, subs_core, "dispatch")
Rel(http, admin_core, "dispatch")
Rel(http, user_core, "dispatch")
Rel(http, webhooks_in, "POST /webhooks/…")
Rel(http, analytics_comp, "OLAP queries")
Rel(http, links_core, "hosted link pages")
Rel(http, relay_core, "relay / proxy")

Rel(payments_core, routing_core, "select connector(s)")
Rel(payments_core, decision_mgr, "3DS / surcharge / tax decisions")
Rel(payments_core, frm_core, "pre & post FRM")
Rel(payments_core, auth3ds, "external authentication")
Rel(payments_core, blocklist, "guard")
Rel(payments_core, pm_core, "tokenize / save / fetch payment method")
Rel(payments_core, mandates_core, "setup / use mandate")
Rel(payments_core, offers_core, "offer eligibility & apply")
Rel(payments_core, connector_layer, "execute flow")
Rel(payments_core, ucs_client, "optional UCS execution path")
Rel(payments_core, scheduler_api, "schedule PSync / retries")
Rel(payments_core, webhooks_out, "emit merchant events")
Rel(payments_core, storage, "read/write intent & attempt")
Rel(refunds_core, connector_layer, "execute refund")
Rel(disputes_core, connector_layer, "evidence & accept")
Rel(payouts_core, connector_layer, "payout flows")
Rel(webhooks_in, payments_core, "reconcile status")
Rel(webhooks_in, connector_layer, "verify source & parse")
Rel(routing_core, open_router, "gRPC scores")
Rel(pm_core, locker, "JWE/JWS")
Rel(storage, pg, "SQL")
Rel(storage, redis, "cache / KV stream")
Rel(storage, keymanager, "encrypt PII")
Rel(connector_layer, connectors_ext, "HTTPS")
Rel(events_comp, kafka, "publish")
Rel(payments_core, events_comp, "audit/analytics events")
Rel(scheduler_api, pg, "process_tracker rows")

SHOW_LEGEND()
@enduml
